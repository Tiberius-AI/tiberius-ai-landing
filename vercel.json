{
  "functions": {
    "api/alfred-router.js": {
      "maxDuration": 90
    }
  },
  "rewrites": [
    {
      "source": "/nb",
      "destination": "/?loc=nb"
    },
    {
      "source": "/tx",
      "destination": "/?loc=tx"
    },
    {
      "source": "/alfred-ai",
      "destination": "/alfred-ai/index.html"
    },
    {
      "source": "/recon",
      "destination": "/recon/index.html"
    },
    {
      "source": "/recon/login",
      "destination": "/recon/login.html"
    },
    {
      "source": "/recon/admin",
      "destination": "/recon/login.html"
    },
    {
      "source": "/recon/briefing",
      "destination": "/recon/briefing.html"
    },
    {
      "source": "/recon/command",
      "destination": "/recon/command.html"
    },
    {
      "source": "/login",
      "destination": "/recon/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/recon/login.html"
    },
    {
      "source": "/login.js",
      "destination": "/recon/login.js"
    },
    {
      "source": "/briefing",
      "destination": "/recon/briefing.html"
    },
    {
      "source": "/briefing.html",
      "destination": "/recon/briefing.html"
    },
    {
      "source": "/briefing.js",
      "destination": "/recon/briefing.js"
    },
    {
      "source": "/command",
      "destination": "/recon/command.html"
    },
    {
      "source": "/command.html",
      "destination": "/recon/command.html"
    },
    {
      "source": "/command.js",
      "destination": "/recon/command.js"
    },
    {
      "source": "/tiberius-recon",
      "destination": "/recon/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/sms-terms",
      "destination": "/sms-terms.html"
    },
    {
      "source": "/sms-consent",
      "destination": "/sms-consent.html"
    },
    {
      "source": "/api/alfred-router/:path*",
      "destination": "/api/alfred-router?path=:path*"
    },
    {
      "source": "/dashboard",
      "destination": "https://tiberius-dashboard-39st.vercel.app/dashboard"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "https://tiberius-dashboard-39st.vercel.app/dashboard/:path*"
    }
  ]
}
